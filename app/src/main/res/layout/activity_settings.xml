<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/forest_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/backButton" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:text="@string/back" android:textColor="@color/forest_accent" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/settings" android:textColor="@color/forest_paper" android:textSize="32sp" android:textStyle="bold" />
        <TextView style="@style/ForestSectionLabel" android:text="@string/protection" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_settings_group" android:orientation="vertical" android:padding="12dp">
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/startOnBootSwitch" style="@style/ForestSwitch" android:checked="true" android:text="@string/start_on_boot" />
        </LinearLayout>
        <TextView style="@style/ForestSectionLabel" android:text="@string/privacy" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_settings_group" android:orientation="vertical" android:padding="12dp">
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/localStatsSwitch" style="@style/ForestSwitch" android:checked="true" android:text="@string/local_stats" />
        </LinearLayout>
        <TextView style="@style/ForestSectionLabel" android:text="@string/app_exclusions" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_exclusions_intro" android:textColor="@color/forest_muted" android:textSize="14sp" />
        <TextView android:id="@+id/reconnectNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/reconnect_required" android:textColor="@color/forest_accent" android:textStyle="bold" android:visibility="gone" />
        <LinearLayout android:id="@+id/excludedAppsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_settings_group" android:orientation="vertical" android:padding="12dp" />
        <TextView style="@style/ForestSectionLabel" android:text="@string/about" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_settings_group" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy_note_title" android:textColor="@color/forest_paper" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/privacy_note" android:textColor="@color/forest_muted" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/version" android:textColor="@color/forest_accent" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
