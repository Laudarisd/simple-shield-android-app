<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/forest_background" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal"
        android:orientation="vertical" android:paddingStart="@dimen/screen_horizontal_padding" android:paddingTop="16dp" android:paddingEnd="@dimen/screen_horizontal_padding" android:paddingBottom="20dp">
        <ImageView android:layout_width="42dp" android:layout_height="42dp"
            android:contentDescription="@string/app_name" android:src="@drawable/forest_shield" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium" android:letterSpacing="0.28" android:text="@string/app_name_caps"
            android:textColor="@color/forest_paper" android:textSize="14sp" />
        <FrameLayout android:id="@+id/protectionHalo" android:layout_width="196dp" android:layout_height="196dp" android:layout_marginTop="20dp"
            android:background="@drawable/bg_protection_halo_off" android:clickable="true" android:contentDescription="@string/toggle_button_label"
            android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless" android:padding="42dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:src="@drawable/forest_shield" />
        </FrameLayout>
        <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium" android:text="@string/status_stopped_short" android:textColor="@color/forest_paper" android:textSize="34sp" android:textStyle="bold" />
        <TextView android:id="@+id/statusDetailText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:gravity="center" android:text="@string/status_stopped_detail" android:textColor="@color/forest_muted" android:textSize="15sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:background="@drawable/bg_settings_group" android:gravity="center" android:orientation="horizontal" android:padding="13dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/adsBlockedCountText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:text="0" android:textColor="@color/forest_accent" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ads_blocked_label" android:textColor="@color/forest_muted" android:textSize="13sp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="54dp" android:background="@color/forest_divider" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/sponsoredBlockedCountText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium"
                    android:text="0" android:textColor="@color/forest_accent" android:textSize="32sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sponsored_blocked_label" android:textColor="@color/forest_muted" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/blockingToggleButton" android:layout_width="match_parent" android:layout_height="64dp"
            android:layout_marginTop="20dp" android:backgroundTint="@color/forest_accent" android:text="@string/start_protection" android:textAllCaps="false"
            android:textColor="@color/forest_background" android:textSize="17sp" android:textStyle="bold" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="32dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/filtersButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="58dp" android:layout_marginEnd="7dp" android:layout_weight="1" android:text="@string/filters"
                android:textAllCaps="false" android:textColor="@color/forest_paper" android:textSize="15sp" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="20dp" app:strokeColor="@color/forest_divider" />
            <com.google.android.material.button.MaterialButton android:id="@+id/settingsLargeButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="7dp" android:layout_weight="1" android:text="@string/settings"
                android:textAllCaps="false" android:textColor="@color/forest_paper" android:textSize="15sp" android:gravity="center" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="20dp" app:strokeColor="@color/forest_divider" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:gravity="center" android:text="@string/auto_off_notice" android:textColor="@color/forest_muted" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
